# OS
.DS_Store

# アプリが管理するライブラリデータ（source が唯一の正、cache/DB は再生成可能）
cache/
exports/
database.db

# Frontend (React + Vite)
node_modules/
dist/
*.tsbuildinfo

# Backend (Go)
*.exe
bin/

# go:embed 用フロントエンドビルド成果物（frontend/ の npm run build が生成）
internal/web/static/*
!internal/web/static/.gitkeep

# ローカル環境設定
.env
.claude/settings.local.json
